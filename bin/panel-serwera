#!/bin/bash
# Polecenie panelu serwera (instalowane jako /usr/local/bin/panel-serwera).
#   panel-serwera status | wersja | link | aktualizuj | logi | reset-logowania | odinstaluj
set -uo pipefail
DIR=${PANEL_DIR:-/opt/panel-serwera}
USLUGA=${PANEL_USLUGA:-panel-serwera}
DATA=${DATA_DIR:-/var/lib/panel-serwera}
LOG=${PANEL_LOG:-/var/log/panel-aktualizacja.log}
ver() { node -p "require('$DIR/package.json').version" 2>/dev/null; }
adres() { node -e "try{const c=require('$DATA/konfiguracja.json');process.stdout.write(c.adres||'')}catch{}" 2>/dev/null; }
pytaj() { [ "${BEZ_PYTAN:-}" = 1 ] && return 0; read -r -p "$1 [t/N] " a </dev/tty; [[ "$a" =~ ^[tTyY] ]]; }

case "${1:-pomoc}" in
  status)
    systemctl --no-pager status panel-serwera | head -4
    echo "wersja: $(ver)"; a=$(adres); [ -n "$a" ] && echo "adres:  https://$a/" ;;
  wersja) ver ;;
  link)
    if [ -s "$DATA/kod-konfiguracji.txt" ]; then
      code=$(cat "$DATA/kod-konfiguracji.txt"); a=$(adres)
      if [ -n "$a" ]; then echo "https://$a/#setup=$code"; else ip=$(curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}'); echo "https://$ip:8443/#setup=$code"; fi
    else echo "Panel jest już skonfigurowany. Adres: https://$(adres)/  (zgubione hasło lub telefon: panel-serwera reset-logowania)"; fi ;;
  aktualizuj)
    [ "${2:-}" = "--bez-pytan" ] && BEZ_PYTAN=1
    {
      echo "=== $(date '+%F %T') aktualizacja panelu (była $(ver))"
      cd "$DIR" || exit 1
      git fetch --tags --quiet origin || { echo "Nie mogę pobrać z GitHuba."; exit 1; }
      tag=$(git tag -l 'v*' --sort=-v:refname | head -1)
      [ -z "$tag" ] && { echo "Brak wydań na GitHubie."; exit 1; }
      if [ "v$(ver)" = "$tag" ]; then echo "Masz najnowszą wersję ($tag)."; exit 0; fi
      git -c advice.detachedHead=false checkout --quiet "$tag" || { echo "Nie udało się przełączyć na $tag (zmiany w plikach panelu?)."; exit 1; }
      npm ci --omit=dev --no-audit --no-fund --loglevel=error || { echo "npm ci nie wyszło"; exit 1; }
      systemctl restart "$USLUGA" && echo "✓ Panel zaktualizowany do $tag." || { echo "Nie udało się uruchomić panelu po aktualizacji: journalctl -u $USLUGA -n 50"; exit 1; }
    } 2>&1 | tee -a "$LOG" ;;
  logi) journalctl -u panel-serwera -n "${2:-100}" --no-pager ;;
  reset-logowania)
    pytaj "Usunąć konta panelu i zacząć konfigurację od nowa? (strony, bazy i ustawienia zostają)" || exit 1
    sqlite3 "$DATA/panel.sqlite" "DELETE FROM users; DELETE FROM sessions; DELETE FROM fails;"
    systemctl restart panel-serwera; sleep 2; "$0" link ;;
  odinstaluj) exec bash "$DIR/odinstaluj.sh" "${@:2}" ;;
  *) echo "Użycie: panel-serwera status | wersja | link | aktualizuj | logi [N] | reset-logowania | odinstaluj [--wszystko]" ;;
esac
